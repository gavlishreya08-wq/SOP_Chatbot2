# LLM provider to use by default: gemini or groq
llm_provider=gemini

# Gemini
gemini_api_key=
gemini_model=gemini-2.5-pro

# Groq
groq_api_key=
groq_model=llama-3.1-8b-instant

# Admin
admin_password=change-this-password
jwt_secret=replace-with-a-long-random-secret

# Optional content and storage path overrides
# sop_documents_dir=C:\path\to\sop_documents
# flowcharts_dir=C:\path\to\flowcharts
# img_txt_dir=C:\path\to\img_txt
# chroma_db_dir=C:\path\to\chroma_db
# sop_metadata_path=C:\path\to\sop_metadata.json
# data_dir=C:\path\to\data

# Optional sync base URL
# sop_base_url=https://upaygoa.com/geltm/helpndoc
